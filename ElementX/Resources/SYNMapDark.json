{
  "version": 8,
  "name": "SYN Map Dark",
  "sources": {
    "openstreetmap": {
      "type": "raster",
      "tiles": ["https://tile.openstreetmap.org/{z}/{x}/{y}.png"],
      "tileSize": 256,
      "attribution": "© OpenStreetMap contributors",
      "maxzoom": 19
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#111820" }
    },
    {
      "id": "openstreetmap",
      "type": "raster",
      "source": "openstreetmap",
      "paint": {
        "raster-brightness-max": 0.55,
        "raster-saturation": -0.7
      }
    }
  ]
}
